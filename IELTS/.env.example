# ───────── Copy this file to ".env" (same folder as app.py). 100% free-tier setup. ─────────
FLASK_ENV=development
JWT_SECRET_KEY=change-me-to-a-long-random-string

# SQLite file for local use. For free hosted Postgres (Supabase/Neon) paste its connection string instead.
DATABASE_URL=sqlite:///ielts.db

# Browser origins allowed to call the API (your Vite dev URL / deployed frontend URL)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
BACKEND_BASE_URL=http://localhost:5000

# Time zone for 1-on-1 slots (minutes from UTC). 330 = India (IST).
APP_TZ_OFFSET_MINUTES=330

# ── Audio storage ──
# Leave blank locally: audio is saved in ./uploads.
# For a deployed app use Cloudinary's FREE plan (https://cloudinary.com) — required in production
# because free hosts wipe local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional e-mail (Gmail app password is free). Not needed for the core app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
